{{> menu}}

{{#if error}}
<div class="alert alert-warning mt-3">{{error}}</div>
{{/if}}

<h2 class="mt-4">Suchergebnisse</h2>
<p class="text-muted">Orte mit gutem Wetter am Wochenende in deiner Nähe</p>

<div class="row mt-3">
  {{#each destinations}}
  <div class="col-md-4 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">{{this.name}}</h5>
        <p class="card-text text-muted">{{this.distance_km}} km entfernt</p>

        {{#if this.weather}}
        <div class="mb-2">
          <small class="text-muted">Wochenende:</small><br>
          <span>Sa: {{this.weather.saturday.emoji}} {{this.weather.saturday.temp}}°C — {{this.weather.saturday.label}}</span><br>
          <span>So: {{this.weather.sunday.emoji}} {{this.weather.sunday.temp}}°C — {{this.weather.sunday.label}}</span>
        </div>
        {{/if}}

        <p class="card-text">{{this.description}}</p>
        <a href="/destinations/{{this.id}}" class="btn btn-outline-primary btn-sm">Details</a>
      </div>
    </div>
  </div>
  {{/each}}
  {{#unless destinations.length}}
  <div class="alert alert-info mt-3">
  Keine Reiseziele gefunden. Versuche eine größere Entfernung.
  </div>
  {{/unless}}
  {{#if destinations.length}}
  <div class="d-flex justify-content-between align-items-center mt-3">
  {{#if hasPrev}}
  <a href="/search?location={{location}}&maxDistance={{maxDistance}}&page={{subtract currentPage 1}}" class="btn btn-outline-secondary">← Zurück</a>
  {{else}}
  <span></span>
  {{/if}}

  <span class="text-muted">Seite {{currentPage}} von {{totalPages}}</span>

  {{#if hasNext}}
  <a href="/search?location={{location}}&maxDistance={{maxDistance}}&page={{add currentPage 1}}" class="btn btn-outline-secondary">Weiter →</a>
  {{else}}
  <span></span>
  {{/if}}
  </div>
  {{/if}}
</div>